#!/usr/bin/env python3

import os
import sys
import pymysql


DB_HOST = os.environ.get("VICIDIAL_DB_HOST", "127.0.0.1")
DB_USER = os.environ.get("VICIDIAL_DB_USER", "cron")
DB_PASS = os.environ.get("VICIDIAL_DB_PASS", "1234")
DB_NAME = os.environ.get("VICIDIAL_DB_NAME", "asterisk")


DISPOSITION_STATUS = {
    "Interested – Agent Call": "Inter",
    "Interested – WhatsApp": "Whats",
    "Interested – Specific Model": "Inter",
    "Not Interested": "NI",
    "Call Back Later": "CALLBK",
    "Wrong Number": "DC",
    "Do Not Contact": "DNC",
}


def db():
    return pymysql.connect(
        host=DB_HOST,
        user=DB_USER,
        password=DB_PASS,
        database=DB_NAME,
        charset="utf8mb4",
        autocommit=True,
    )


def find_lead_by_id(lead_id):
    if not lead_id:
        return None

    conn = db()

    try:
        with conn.cursor(pymysql.cursors.DictCursor) as cur:
            cur.execute(
                """
                SELECT *
                FROM vicidial_list
                WHERE lead_id=%s
                LIMIT 1
                """,
                (int(lead_id),),
            )
            return cur.fetchone()
    finally:
        conn.close()


def find_lead_by_phone(phone_number):
    if not phone_number:
        return None

    phone = "".join(
        c for c in str(phone_number)
        if c.isdigit()
    )

    if not phone:
        return None

    conn = db()

    try:
        with conn.cursor(pymysql.cursors.DictCursor) as cur:
            cur.execute(
                """
                SELECT *
                FROM vicidial_list
                WHERE phone_number=%s
                ORDER BY lead_id DESC
                LIMIT 1
                """,
                (phone,),
            )
            return cur.fetchone()
    finally:
        conn.close()


def resolve_lead(lead_id=None, phone_number=None):
    """
    Existing lead resolution.

    Priority:
      1. lead_id
      2. phone number
    """

    lead = find_lead_by_id(lead_id)

    if lead:
        return {
            "success": True,
            "source": "existing_lead_id",
            "created": False,
            "lead_id": lead["lead_id"],
            "phone_number": lead.get("phone_number"),
            "first_name": lead.get("first_name"),
            "address1": lead.get("address1"),
            "address2": lead.get("address2"),
            "lead": lead,
        }

    lead = find_lead_by_phone(phone_number)

    if lead:
        return {
            "success": True,
            "source": "existing_phone",
            "created": False,
            "lead_id": lead["lead_id"],
            "phone_number": lead.get("phone_number"),
            "first_name": lead.get("first_name"),
            "address1": lead.get("address1"),
            "address2": lead.get("address2"),
            "lead": lead,
        }

    return {
        "success": False,
        "source": "not_found",
        "created": False,
        "lead_id": None,
        "phone_number": phone_number,
    }


def create_lead(
    phone_number,
    first_name=None,
    address1=None,
    address2=None,
    list_id=1102026,
    status="N",
):
    """
    Create a new VICIdial lead.

    POC default list_id = 1102026.
    Change this to the Toyota outbound list if required.
    """

    phone = "".join(
        c for c in str(phone_number or "")
        if c.isdigit()
    )

    if not phone:
        return {
            "success": False,
            "created": False,
            "error": "Missing phone number",
        }

    # Never create a duplicate.
    existing = find_lead_by_phone(phone)

    if existing:
        return {
            "success": True,
            "created": False,
            "source": "existing_phone",
            "lead_id": existing["lead_id"],
            "phone_number": existing.get("phone_number"),
        }

    conn = db()

    try:
        with conn.cursor() as cur:

            cur.execute(
                """
                INSERT INTO vicidial_list
                (
                    entry_date,
                    status,
                    user,
                    vendor_lead_code,
                    source_id,
                    list_id,
                    gmt_offset_now,
                    called_since_last_reset,
                    phone_code,
                    phone_number,
                    title,
                    first_name,
                    middle_initial,
                    last_name,
                    address1,
                    address2,
                    address3,
                    city,
                    state,
                    province,
                    postal_code,
                    country_code,
                    gender,
                    date_of_birth,
                    alt_phone,
                    email,
                    security_phrase,
                    comments,
                    called_count,
                    rank,
                    owner
                )
                VALUES
                (
                    NOW(),
                    %s,
                    '',
                    '',
                    '',
                    %s,
                    8.00,
                    'N',
                    '60',
                    %s,
                    '',
                    %s,
                    '',
                    '',
                    %s,
                    %s,
                    '',
                    '',
                    '',
                    '',
                    '',
                    'MY',
                    '',
                    '',
                    '',
                    '',
                    '',
                    'Toyota AI POC',
                    0,
                    0,
                    ''
                )
                """,
                (
                    status,
                    int(list_id),
                    phone,
                    first_name or "",
                    address1 or "",
                    address2 or "",
                ),
            )

            new_lead_id = cur.lastrowid
            conn.commit()

        return {
            "success": True,
            "created": True,
            "source": "new_lead",
            "lead_id": int(new_lead_id),
            "phone_number": phone,
        }

    except Exception as exc:
        return {
            "success": False,
            "created": False,
            "error": repr(exc),
        }

    finally:
        conn.close()


def resolve_or_create_lead(
    lead_id=None,
    phone_number=None,
    first_name=None,
    address1=None,
    address2=None,
    list_id=1102026,
):
    result = resolve_lead(
        lead_id=lead_id,
        phone_number=phone_number,
    )

    if result.get("success"):
        print(
            "VICIDIAL EXISTING LEAD:",
            result.get("lead_id")
        )
        return result

    print(
        "VICIDIAL LEAD NOT FOUND - CREATING NEW LEAD"
    )

    result = create_lead(
        phone_number=phone_number,
        first_name=first_name,
        address1=address1,
        address2=address2,
        list_id=list_id,
    )

    print(
        "VICIDIAL NEW LEAD RESULT:",
        result
    )

    return result


def update_lead_status(lead_id, disposition, ai_comments=None):
    if not lead_id:
        return {
            "success": False,
            "error": "Missing lead_id",
        }

    status = DISPOSITION_STATUS.get(disposition)

    if not status:
        return {
            "success": False,
            "error": f"Unknown disposition: {disposition}",
        }

    conn = db()

    try:
        with conn.cursor(pymysql.cursors.DictCursor) as cur:

            cur.execute(
                """
                SELECT lead_id, status, phone_number, comments
                FROM vicidial_list
                WHERE lead_id=%s
                LIMIT 1
                """,
                (int(lead_id),),
            )

            lead = cur.fetchone()

            if not lead:
                return {
                    "success": False,
                    "error": "Lead not found",
                    "lead_id": int(lead_id),
                }

            old_status = lead["status"]
            old_comments = (lead.get("comments") or "").strip()

            # AI remark
            if ai_comments:
                ai_comment = ai_comments
            else:
                ai_comment = f"AI: {disposition}"

            if old_comments:
                new_comments = old_comments + " | " + ai_comment
            else:
                new_comments = ai_comment

            cur.execute(
                """
                UPDATE vicidial_list
                SET status=%s,
                    comments=%s,
                    modify_date=NOW()
                WHERE lead_id=%s
                """,
                (
                    status,
                    new_comments,
                    int(lead_id),
                ),
            )

            cur.execute(
                """
                SELECT status, comments
                FROM vicidial_list
                WHERE lead_id=%s
                LIMIT 1
                """,
                (int(lead_id),),
            )

            verified = cur.fetchone()

        return {
            "success": True,
            "lead_id": int(lead_id),
            "old_status": old_status,
            "new_status": verified["status"],
            "vicidial_status": status,
            "ai_disposition": disposition,
            "comments": verified["comments"],
        }

    finally:
        conn.close()


if __name__ == "__main__":

    if len(sys.argv) < 3:
        print(
            "Usage:"
            "\n  python3 src/toyota_vicidial.py <lead_id> <disposition>"
        )
        sys.exit(1)

    lead_id = sys.argv[1]
    disposition = sys.argv[2]

    print(
        update_lead_status(
            lead_id,
            disposition,
        )
    )
